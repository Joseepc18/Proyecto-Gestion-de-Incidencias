APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=gestion_incidencias
DB_USERNAME=admin
DB_PASSWORD=

# Clave del admin sembrado por RolesYUsuariosSeeder (admin@sistema.com). En prod se pone a mano
# en el .env del servidor con una clave real; sin esta variable el seeder cae al fallback de dev.
SEED_ADMIN_PASSWORD=password123


SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# redis: la cola la procesa Horizon (contenedor "horizon"); mail y notificaciones se difieren.
QUEUE_CONNECTION=redis

# WebSockets (Laravel Reverb). El backend publica eventos al contenedor "reverb".
# REVERB_HOST/PORT/SCHEME = cómo el BACKEND alcanza al servidor Reverb (red interna de Docker).
# El navegador NO usa estas vars: su config (dominio público / 443 / wss) vive en el frontend.
REVERB_APP_ID=incidencias
REVERB_APP_KEY=incidencias-key
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Login con Google (OAuth). En producción Dayron pone las llaves a mano en el .env del servidor.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"
FRONTEND_URL="${APP_URL}"
