# .env de la RAÍZ: solo lo que docker-compose.yml interpola (${VAR}) al levantar el stack.
# NO es el .env de Laravel (ese vive en backend/.env; ver backend/.env.example).
# Copia este archivo a .env y pon valores reales. El .env real está gitignored.

# Password de PostgreSQL (contenedor db). Obligatorio: sin él la BD arranca con clave vacía.
POSTGRES_PASSWORD=cambia-esto

# Password de Redis (contenedor redis y TODOS sus clientes: backend, horizon, reverb, scheduler).
# Obligatorio y debe ser IDÉNTICO en todos. El compose ahora falla si falta (ya no hay default).
# Generar con: openssl rand -hex 24
REDIS_PASSWORD=cambia-esto

# Raíz que sirve Nginx. En prod = ./frontend/dist (el build de esbuild); en dev se deja
# sin setear y sirve ./frontend crudo.
# FRONTEND_ROOT=./frontend/dist
